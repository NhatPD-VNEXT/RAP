// Draft table — same fields as persistent table + draft admin columns.
// Naming convention: <persistent table>_D
@EndUserText.label : '{{CASE_NAME}} Header — Draft'
@AbapCatalog.enhancement.category : #NOT_EXTENSIBLE
@AbapCatalog.tableCategory : #TRANSPARENT
@AbapCatalog.deliveryClass : #A
@AbapCatalog.dataMaintenance : #LIMITED
define table {{TABLE}}_d {

  key client                  : abap.clnt not null;
  key sales_order             : sysuuid_x16 not null;

  document_number             : abap.char(20);
  // ... mirror persistent table fields ...

  created_by                  : abp_creation_user;
  created_at                  : timestampl;
  last_changed_by             : abp_last_change_user;
  last_updated_at             : timestampl;
  local_last_updated_at       : timestampl;

  // Draft admin columns (BẮT BUỘC)
  "%admin"                    : include sych_bdl_draft_admin_inc;

}
