projection;
strict ( 2 );
use draft;

define behavior for {{PROJECTION}} alias Header
use etag
{
  use create;
  use update;
  use delete;

  use association _Item { create; with draft; }

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
}

define behavior for {{PROJECTION_ITEM}} alias Item
use etag
{
  use update;
  use delete;
  use association _Header { with draft; }
}
