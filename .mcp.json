{
    "mcpServers": {
        "sap-adt": {
            "type": "http",
            "url": "http://127.0.0.1:8765/mcp"
        },
        "sap-docs": {
            "type": "http",
            "url": "https://mcp-sap-docs.marianzeis.de/mcp"
        },
        "sap-abap": {
            "type": "http",
            "url": "https://mcp-abap.marianzeis.de/mcp"
        },
        "agentmemory": {
            "command": "npx",
            "args": [
                "-y",
                "@agentmemory/mcp"
            ],
            "env": {
                "AGENTMEMORY_URL": "http://localhost:3111"
            }
        },
        "chrome-devtools": {
            "command": "npx",
            "args": [
                "-y",
                "chrome-devtools-mcp@latest",
                "--autoConnect"
            ]
        }
    }
}